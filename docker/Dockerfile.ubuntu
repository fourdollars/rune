# Rebuild trigger: include rune notes serve mode
FROM rust:bookworm AS builder
WORKDIR /app

RUN ARCH=$(uname -m) \
    && case "$ARCH" in \
         x86_64) UPX_ARCH="amd64" ;; \
         aarch64) UPX_ARCH="arm64" ;; \
         *) echo "Unsupported arch: $ARCH" && exit 1 ;; \
       esac \
    && curl -sL "https://github.com/upx/upx/releases/download/v4.2.4/upx-4.2.4-${UPX_ARCH}_linux.tar.xz" \
       | tar -xJf - -C /usr/local/bin --strip-components=1 "upx-4.2.4-${UPX_ARCH}_linux/upx"

COPY Cargo.toml Cargo.lock ./
COPY build.rs ./
COPY src ./src
COPY web ./web
RUN cargo build --release --locked --features notes \
    && upx --best --lzma /app/target/release/rune

FROM ubuntu:latest
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --home-dir /home/rune --shell /usr/sbin/nologin rune

COPY --chmod=0755 --from=builder /app/target/release/rune /usr/local/bin/rune

# Concourse resource type: symlinks preserve argv[0] for mode detection
RUN mkdir -p /opt/resource \
    && ln -s /usr/local/bin/rune /opt/resource/check \
    && ln -s /usr/local/bin/rune /opt/resource/in \
    && ln -s /usr/local/bin/rune /opt/resource/out

# Entrypoint drops to rune user for normal docker run
COPY --chmod=0755 docker/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

WORKDIR /home/rune
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
