# Rebuild trigger: include rune notes serve mode
FROM rust:alpine AS builder
WORKDIR /app

RUN rustup target add x86_64-unknown-linux-musl
RUN apk add --no-cache build-base musl-dev upx

COPY Cargo.toml Cargo.lock ./
COPY build.rs ./
COPY src ./src
COPY web ./web
RUN cargo build --release --locked --features notes --target x86_64-unknown-linux-musl \
    && upx --best --lzma /app/target/x86_64-unknown-linux-musl/release/rune

FROM alpine:latest
RUN apk add --no-cache ca-certificates

RUN addgroup -g 1000 rune \
    && adduser -D -u 1000 -G rune -h /home/rune rune

COPY --chmod=0755 --from=builder /app/target/x86_64-unknown-linux-musl/release/rune /usr/local/bin/rune

# Concourse resource type: symlinks preserve argv[0] for mode detection
RUN mkdir -p /opt/resource \
    && ln -s /usr/local/bin/rune /opt/resource/check \
    && ln -s /usr/local/bin/rune /opt/resource/in \
    && ln -s /usr/local/bin/rune /opt/resource/out

# Entrypoint drops to rune user for normal docker run
COPY --chmod=0755 docker/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

WORKDIR /home/rune
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
